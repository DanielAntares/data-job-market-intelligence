# Copy this file to ".env" and fill in your own keys (the real .env is git-ignored).
# Adzuna credentials — free signup at https://developer.adzuna.com/
ADZUNA_APP_ID=your_app_id_here
ADZUNA_APP_KEY=your_app_key_here

# Jooble API key — free, for Indonesia/Malaysia postings.
# Request one at https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_key_here

# RapidAPI key — free, for JSearch (Google for Jobs: LinkedIn/Indeed/Glassdoor),
# global incl. Indonesia. Subscribe to the free JSearch tier, then paste the key:
# https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=your_rapidapi_key_here
