# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/
.ipynb_checkpoints/

# Note: reports/figures/*.png and notebooks/*.ipynb ARE committed on purpose
# (so the README charts and the notebook render on GitHub).

# Data — ignore the bulky raw snapshots, but DO commit the small warehouse
# parquets so the deployed dashboard (and a fresh clone) has data to show.
data/raw/*
!data/raw/.gitkeep
data/warehouse/*
!data/warehouse/.gitkeep
!data/warehouse/*.parquet

# Secrets (Adzuna keys etc. live here once you add them)
.env
config.local.yaml

# OS / editor
.DS_Store
.vscode/
.idea/
